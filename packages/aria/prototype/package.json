{
  "name": "@deepseek-ai/dsh-aria-prototype",
  "description": "Aria visual prototype: the Overview, Missions, Agents, Knowledge, Activity and Settings screens built on the DSH client shell and ui-primitives atoms, with demonstration data only",
  "version": "0.2.1-alpha.2",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabielrtxofc-coder/Aria-Repository.git",
    "directory": "packages/aria/prototype"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-aria-theme": "workspace:*",
    "@deepseek-ai/dsh-aria-wordmark": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "preview": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts"
  }
}
